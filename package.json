{
  "name": "promptwear",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "docker:up": "docker compose up -d --wait && bash scripts/init-minio.sh",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d --wait && bash scripts/init-minio.sh",
    "dev:api": "npm run start:dev --prefix backend",
    "dev:web": "npm run dev --prefix client"
  }
}
