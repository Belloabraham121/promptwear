{
  "moduleFileExtensions": ["js", "mjs", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/test/**/*.e2e-spec.ts"],
  "maxWorkers": 1,
  "transform": {
    "node_modules/(better-auth|better-call|jose|ohash|rou3|@better-auth|@noble|nanospinner|picocolors)/.+\\.m?js$": [
      "ts-jest",
      { "tsconfig": "<rootDir>/test/tsconfig.e2e-esm.json" }
    ],
    "^.+\\.(t|j)s$": "ts-jest",
    "^.+\\.mjs$": ["ts-jest", { "tsconfig": "<rootDir>/test/tsconfig.e2e-esm.json" }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(better-auth|better-call|jose|ohash|rou3|@better-auth|@noble|nanospinner|picocolors)/)"
  ]
}
